# Clave del proveedor LLM. Solo se lee en el backend; nunca use el prefijo
# NEXT_PUBLIC_ (quedaría expuesta al navegador) ni la publique en el repositorio.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Opcionales (tienen valores por defecto razonables si se omiten)
OPENAI_TIMEOUT_MS=30000
AGENT_MAX_ITERATIONS=25
AGENT_MAX_OUTPUT_TOKENS=2000
AGENT_MAX_SESSION_TURNS=30
AGENT_RATE_LIMIT=20
